# ===== MODO: signals (solo Telegram) -> paper (simulado) -> live (dinero real) =====
BOT_MODE=signals
BOT_EXCHANGE=bingx

# ===== Triada para el SSMT (activo 1 = el que se opera; activos 2 y 3 = referencias) =====
# Formato ccxt de perpetuos: MONEDA/USDT:USDT   (busca simbolos con: python qs_bot.py markets --filter NAS)
BOT_TRADE_SYMBOL=BTC/USDT:USDT
BOT_TRIAD=ETH/USDT:USDT,SOL/USDT:USDT

# ===== Telegram =====
TELEGRAM_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# ===== Riesgo =====
BOT_RISK_PCT=0.5
BOT_LEVERAGE=3
BOT_PAPER_EQUITY=1000
BOT_MAX_DAILY_LOSS=3
BOT_MAX_CONSEC_LOSSES=3
BOT_PAUSE_MINUTES=360

# ===== Persistencia (Volume de Railway montado en /data) =====
DATA_DIR=/data

# ===== SOLO PARA LIVE (dinero real) =====
# BOT_API_KEY=            # API key de BingX SIN permiso de retiro
# BOT_API_SECRET=
# BOT_TESTNET=false
# BOT_CONFIRM_LIVE=YES
# BOT_HEDGE=true          # true = modo cobertura (LONG/SHORT, el de BingX por defecto); false = one-way
# BOT_SL_TP_MODE=separate

# ===== Ajustes de la estrategia (opcional, JSON). Valores por defecto = los del indicador =====
# BOT_PARAMS={"stage_cyc":"Diario","use2":true,"align_mode":"369 o cadena","tp_mode":"Extension 137","min_rr":1.0}
